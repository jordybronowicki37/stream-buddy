// Rename to setup.json and move to data folder
[
  {
    "name": "MY FAVORITE STREAMER",
    "url": "https://www.twitch.tv/STREAMER",
    "show_url": true,
    "selector": ".tw-channel-status-text-indicator span:has-text(\"LIVE\")",
    "online_grace_period": 1, // Wait in minutes to verify that the streamer has actually started streaming, this is to prevent wrongfully claiming a streamer has started streaming
    "offline_grace_period": 5, // Wait in minutes for the streamer to come online again before marking the stream as officially ended
    "notify_when_online": true,
    "notify_when_offline": true
  },
  {
    "name": "ANOTHER FAVORITE STREAMER",
    "url": "https://www.stream.tv/STREAMER",
    "show_url": true,
    "selector": ".player-live-badge",
    "online_grace_period": 1,
    "offline_grace_period": 5,
    "notify_when_online": true,
    "notify_when_offline": true
  }
]